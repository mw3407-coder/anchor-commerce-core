# MercurJS / Medusa production environment
# Copy this file to apps/api/.env on the server and replace every placeholder.
# Never commit apps/api/.env or any file containing real secrets.

NODE_ENV=production
PORT=9000

# PostgreSQL
DATABASE_URL=postgres://medusa:CHANGE_ME@127.0.0.1:5432/medusa

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Generate long random values for production.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
COOKIE_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_VALUE

# Allowed browser origins. Use comma-separated URLs where required.
STORE_CORS=http://YOUR_PUBLIC_HOST
ADMIN_CORS=http://YOUR_PUBLIC_HOST
VENDOR_CORS=http://YOUR_PUBLIC_HOST
AUTH_CORS=http://YOUR_PUBLIC_HOST

# Public origin used by the local file provider for uploaded assets.
FILE_BACKEND_URL=http://YOUR_PUBLIC_HOST/static

# Run one process in single-server mode. For a production split deployment,
# use MEDUSA_WORKER_MODE=server and MEDUSA_WORKER_MODE=worker separately.
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# Optional vendor-panel origin override used by custom integrations.
# MERCUR_VENDOR_URL=http://YOUR_PUBLIC_HOST/seller
